############################################
# Project settings
############################################
PORT=3001

############################################
# PostgreSQL settings
# Keep DATABASE_URL in sync with the PG* vars below.
############################################
PGHOST=localhost
PGPORT=5432
PGDATABASE=ecomapdb
PGUSER=admin
PGPASSWORD=YOUR_PASSWORD_HERE
DATABASE_URL=postgres://admin:YOUR_PASSWORD_HERE@localhost:5432/ecomapdb

############################################
# Firebase
############################################
FIREBASE_KEY_PATH=./service-account-key.json
