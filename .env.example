############################################
# Project settings
############################################
PORT=3001

############################################
# PostgreSQL settings
# Keep DATABASE_URL in sync with the PG* vars below.
############################################
PGHOST=localhost
PGPORT=5432
PGDATABASE=ecomapdb
PGUSER=admin
PGPASSWORD=YOUR_PASSWORD_HERE
DATABASE_URL=postgres://admin:YOUR_PASSWORD_HERE@localhost:5432/ecomapdb

############################################
# Firebase
############################################
FIREBASE_KEY_PATH=./firebase-service-account-key.json

############################################
# JWT
############################################
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

############################################
# External APIs
############################################
NAVARRA_RESOURCE_ID=e4e0017a-4b3a-4fbe-99b7-9a742c3bcd79
BARCELONA_RESOURCE_ID=c9d4d10b-97dd-4824-a7d8-5acf068d1cb8

############################################
# OpenRouteService
############################################
ORS_API_KEY=your_openrouteservice_api_key_here

############################################
# Proxy Worker for Navarra API
############################################
NAVARRA_PROXY_BASE=YOUR_CLOUDFLARE_WORKER_URL_HERE

############################################
# Environment
############################################
NODE_ENV=development

############################################
# Logging (nivells i filtres per namespaces)
# - LOG_LEVEL: error | warn | info | debug | trace (per defecte: info)
# - LOG_NAMESPACES: llista separada per comes amb patrons amb "*"
#   Exemples:
#     LOG_LEVEL=debug
#     LOG_NAMESPACES=navarra-sync,cache
#     LOG_NAMESPACES=navarra*,scheduler
#     LOG_NAMESPACES=*              # activa tots els namespaces (només recomanat en local)
############################################
LOG_LEVEL=info
LOG_NAMESPACES=

############################################
# Clave API para el servicio de inteligencia artificial
############################################
AI_SERVICE_API_KEY=tu_clave_secreta_aqui