generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["windows", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model admin {
  user_id         String          @id
  registered_user registered_user @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model reward_bought_by {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id       String
  reward_id       String   @db.Uuid
  bought_at       DateTime @default(now()) @db.Timestamp(6)
  points_cost     Int // guardamos el coste en el momento de la compra

  client          client   @relation(fields: [client_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  reward          reward   @relation(fields: [reward_id], references: [publication_id], onDelete: Cascade, onUpdate: NoAction)
}

model client {
  user_id                             String          @id
  address                             String?
  phone                               String?
  points                              Int
  birth_date                          DateTime?       @db.Date
  description                         String?
  profile_picture                     String?
  streak                              Int
  valorations_score                   Float           @default(0.0)
  registered_user                     registered_user @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  chats_as_user1                      chat[]          @relation("chat_user1")
  chats_as_user2                      chat[]          @relation("chat_user2")
  messages_sent                       message[]       @relation("message_sender")
  saved_recycling_points              saved_recycling_point[]
  reservations                        reservation[]
  valorations_made                    valoration[]    @relation("ValorationAuthor")
  valorations_received                valoration[]    @relation("ValorationTarget")
  publications                        publication[]
  rewards_bought                      reward_bought_by[]
}

model institution {
  user_id         String          @id
  registered_user registered_user @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  publications    publication[]
}

model partner {
  user_id         String          @id
  registered_user registered_user @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model registered_user {
  user_id      String            @id
  name         String
  username     String            @unique
  surname      String?
  dni          String?
  email        String            @unique
  app_language app_language_type
  admin        admin?
  client       client?
  institution  institution?
  partner      partner?
  notification notification[]
  device_tokens device_token[]
  user         user              @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  sessions     session[]
}

model user {
  user_id         String           @id
  registered_user registered_user?
}

model session {
  session_id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jwt             String          @unique
  expiry_date     DateTime
  user_id         String
  registered_user registered_user @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
}

model container {
  container_id       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type               product_type
  is_full            Boolean
  is_damaged         Boolean
  recycling_point_id String?          @db.Uuid
  recycling_point    recycling_point? @relation(fields: [recycling_point_id], references: [recycling_point_id], onDelete: Cascade, onUpdate: NoAction)
}

model recycling_point {
  recycling_point_id String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  api_id             Int
  api_location       api_location
  name               String
  latitude           Decimal        @db.Decimal(9, 6)
  longitude          Decimal        @db.Decimal(9, 6)
  equipment_type     equipment_type
  last_updated       DateTime?
  raw_payload        Json?
  active             Boolean      @default(true)
  created_at         DateTime     @default(now())
  updated_at         DateTime     @updatedAt
  container          container[]
  timetable          timetable[]
  saved_by_clients   saved_recycling_point[]

  @@index([api_location])
  @@index([api_location, api_id])
  @@index([api_location, name])
  @@index([api_location, latitude, longitude])
  @@index([api_location, equipment_type])
  @@unique([api_location, api_id])
}

model time_interval {
  time_interval_id    String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  open_time           DateTime              @db.Time(6)
  end_time            DateTime              @db.Time(6)
  timetable_intervals timetable_intervals[]

  @@unique([open_time, end_time])
}

model timetable {
  timetable_id        String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  week_day            week_day
  recycling_point_id  String                @db.Uuid
  recycling_point     recycling_point       @relation(fields: [recycling_point_id], references: [recycling_point_id], onDelete: Cascade, onUpdate: NoAction)
  timetable_intervals timetable_intervals[]

  @@unique([recycling_point_id, week_day], map: "timetable_recycling_point_id_week_day_key")
}

model timetable_intervals {
  timetable_id     String        @db.Uuid
  time_interval_id String        @db.Uuid
  time_interval    time_interval @relation(fields: [time_interval_id], references: [time_interval_id], onDelete: Cascade, onUpdate: NoAction)
  timetable        timetable     @relation(fields: [timetable_id], references: [timetable_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([timetable_id, time_interval_id])
}

model publication {
  publication_id    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title             String
  description       String?
  date              DateTime            @db.Date
  publication_state state_type
  client_id         String?
  client            client?             @relation(fields: [client_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  institution_id    String?
  institution       institution?        @relation(fields: [institution_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  trade             trade?
  publication_media publication_media?
  reward            reward?
}

model trade {
  trade_id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publication_id    String              @db.Uuid @unique
  item_state        item_state_type
  points_price      Int
  created_at        DateTime            @default(now())
  publication       publication         @relation(fields: [publication_id], references: [publication_id], onDelete: Cascade, onUpdate: NoAction)
  reservations      reservation[]
}

model publication_media {
  media_id       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  media_url      String
  publication_id String      @unique @db.Uuid
  publication    publication @relation(fields: [publication_id], references: [publication_id], onDelete: Cascade, onUpdate: NoAction)
}

model reward {
  publication_id String      @id @db.Uuid
  content        String
  points_price   Int
  available      Boolean     @default(true)
  publication    publication @relation(fields: [publication_id], references: [publication_id], onDelete: Cascade, onUpdate: NoAction)
  buyers         reward_bought_by[]
}

model reservation {
  reservation_id                      String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reservation_date                    DateTime       @default(now())
  confirmed                           Boolean        @default(false)

  trade_id       String   @db.Uuid
  trade          trade    @relation(fields: [trade_id], references: [trade_id], onDelete: Cascade, onUpdate: NoAction)

  client_id      String
  client         client   @relation(fields: [client_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  reservation_ended reservation_ended?

  @@index([trade_id])
  @@index([client_id])
}

model reservation_ended {
  reservation_id String        @id @db.Uuid // pk y fk al mismo tiempo
  ended_at       DateTime      @default(now())

  reservation    reservation   @relation(fields: [reservation_id], references: [reservation_id], onDelete: Cascade, onUpdate: NoAction)
  valorations    valoration[]
}

model valoration {
  valoration_id       String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  score               Int               // tiene que ser entre 0 y 10, validado en código
  comment             String
  
  reservation_id      String            @db.Uuid
  reservation_ended   reservation_ended @relation(fields: [reservation_id], references: [reservation_id], onDelete: Cascade, onUpdate: NoAction)

  valoration_owner    String
  author              client            @relation("ValorationAuthor", fields: [valoration_owner], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  valoration_target   String
  target              client            @relation("ValorationTarget", fields: [valoration_target], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([reservation_id])
  @@index([valoration_owner])
  @@index([valoration_target])
 }
   
model chat {
  chat_id    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user1_id   String
  user2_id   String
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  user1      client    @relation("chat_user1", fields: [user1_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  user2      client    @relation("chat_user2", fields: [user2_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  messages   message[]

  @@unique([user1_id, user2_id])
  @@index([user1_id])
  @@index([user2_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model message {
  message_id    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chat_id       String          @db.Uuid
  sender_id     String
  content       String
  is_read       Boolean         @default(false)
  delivered     Boolean         @default(false)
  is_deleted    Boolean         @default(false)
  is_edited     Boolean         @default(false)
  created_at    DateTime        @default(now()) @db.Timestamp(6)
  chat          chat            @relation(fields: [chat_id], references: [chat_id], onDelete: Cascade, onUpdate: NoAction)
  sender        client          @relation("message_sender", fields: [sender_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  message_media message_media[]

  @@index([chat_id])
  @@index([sender_id])
  @@index([chat_id, is_read])
}

model message_media {
  media_id   String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  media_url  String
  message_id String  @db.Uuid
  message    message @relation(fields: [message_id], references: [message_id], onDelete: Cascade, onUpdate: NoAction)
}

model notification {
  notification_id   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String
  notification_type notification_type
  content           String
  delivered         Boolean           @default(false)
  registered_user   registered_user   @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model device_token {
  token           String          @id
  user_id         String
  updated_at      DateTime        @updatedAt
  registered_user registered_user @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id])
}

model saved_recycling_point {
  user_id            String
  recycling_point_id String          @db.Uuid
  client             client          @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  recycling_point    recycling_point @relation(fields: [recycling_point_id], references: [recycling_point_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, recycling_point_id])
  @@index([user_id])
}

enum app_language_type {
  ca
  es
  en
}

enum api_location {
  Barcelona
  Navarra
}

enum equipment_type {
  Recycling_center               @map("Recycling Center")
  Batteries
  Medicines_and_packaging        @map("Medicines and Packaging")
  Garden_waste                   @map("Garden Waste")
  Clothing_and_footwear          @map("Clothing and Footwear")
  Bulky_waste                    @map("Bulky Waste")
  Glass_containers               @map("Glass Containers")
  Coffee_capsules                @map("Coffee Capsules")
  Used_cooking_oil               @map("Used Cooking Oil")
  Household_construction_waste   @map("Household Construction Waste")
  Community_composting           @map("Community Composting")
}

enum product_type {
  ElectricContainer
  GlassContainer
  OrganicContainer
  PaperContainer
  PlasticContainer
  TextileContainer
  Unrecyclable
}

enum week_day {
  Monday
  Tuesday
  Wednesday
  Thursday
  Friday
  Saturday
  Sunday
}

enum item_state_type {
  New
  Little_used   @map("Little used")
  Widely_used   @map("Widely used")
  Bad_condition @map("Bad condition")
}

enum state_type {
  Completed
  Cancelled
  Pending
}

enum notification_type {
  Collection_services  @map("Collection Services")
  Container_states     @map("Container States")
  Recycling_events     @map("Recycling Events")
  New_rewards          @map("New Rewards")
  New_trade            @map("New Trade")
  New_message          @map("New Message")
  Incidences
}

// --- Cache system metadata ---
model cache_metadata {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source        String        @unique // e.g., 'NAVARRA_POINTS'
  last_sync     DateTime?
  next_sync     DateTime?
  status        cache_status  @default(READY)
  error_message String?
  total_records Int           @default(0)
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
}

enum cache_status {
  SYNCING
  READY
  ERROR
}
