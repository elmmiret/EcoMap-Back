{
  "name": "peskaos-back",
  "version": "1.0.0",
  "description": "Backend d'EcoMap amb Node.js i Express",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "prepare": "husky install",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate": "prisma migrate deploy && prisma generate",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "token:firebase": "node scripts/generate-firebase-token.js"
  },
  "imports": {
    "#lib/*": "./src/lib/*",
    "#config/*": "./src/config/*",
    "#services/*": "./src/services/*",
    "#controllers/*": "./src/api/controllers/*",
    "#middlewares/*": "./src/api/middlewares/*",
    "#routes/*": "./src/api/routes/*",
    "#jobs/*": "./src/jobs/*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pes2526q1-1x-gei-upc/PESkaos-back.git"
  },
  "author": "PESkaos Team",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/pes2526q1-1x-gei-upc/PESkaos-back/issues"
  },
  "homepage": "https://github.com/pes2526q1-1x-gei-upc/PESkaos-back#readme",
  "dependencies": {
    "@prisma/client": "^6.17.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "firebase-admin": "^13.5.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@vitest/coverage-v8": "^4.0.3",
    "eslint": "^9.37.0",
    "eslint-plugin-perfectionist": "^4.15.1",
    "execa": "^9.6.0",
    "firebase": "^12.6.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "inquirer": "^12.9.6",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.4",
    "prettier": "^3.6.2",
    "prisma": "^6.17.1",
    "vitest": "^4.0.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml,md}": [
      "prettier --write"
    ]
  }
}
