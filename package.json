{
  "name": "peskaos-back",
  "version": "1.0.0",
  "description": "Backend d'EcoMap amb Node.js, TypeScript i Express",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "prepare": "husky install",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pes2526q1-1x-gei-upc/PESkaos-back.git"
  },
  "author": "PESkaos Team",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/pes2526q1-1x-gei-upc/PESkaos-back/issues"
  },
  "homepage": "https://github.com/pes2526q1-1x-gei-upc/PESkaos-back#readme",
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "eslint": "^9.37.0",
    "eslint-plugin-perfectionist": "^4.15.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.46.0",
    "tsx": "^3.12.7",
    "typescript": "^5.0.4",
    "vitest": "^0.34.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml,md}": [
      "prettier --write"
    ]
  }
}
